---
import Base from '../layouts/Base.astro';
---
<Base title="Contact" path="/contact">
  <div class="page wide">
    <h1 class="who">Luc Nijs</h1>
    <p>Performer - Educator - Researcher</p>
    <p class="gap">Associate Professor in Early Childhood Music Education @ University of Luxembourg</p>
    <p class="gap">Visiting Professor @ Ghent University</p>
    <p class="gap" style="margin-top:36px"><a class="plain" href="mailto:info@kimupe.education">info@kimupe.education</a></p>
    <p class="gap"><a class="blue plain" href="https://wwwen.uni.lu/recherche/fhse/desw/people/luc_nijs" target="_blank" rel="noopener">Webpage University of Luxembourg</a></p>
    <p><a class="orange plain" href="http://www.lucnijs.be" target="_blank" rel="noopener">Personal Webpage</a></p>

    <form class="form" data-contact>
      <input type="text" name="name" placeholder="Name *" aria-label="Name" required />
      <input type="email" name="email" placeholder="Email *" aria-label="Email" required />
      <input class="full" type="text" name="subject" placeholder="Subject" aria-label="Subject" />
      <textarea class="full" name="message" placeholder="Message" aria-label="Message"></textarea>
      <button type="submit">Send</button>
      <p class="form-note" data-note hidden></p>
    </form>
  </div>
  <script>
    const TO = 'info@kimupe.education';
    const form = document.querySelector<HTMLFormElement>('[data-contact]');
    const note = document.querySelector<HTMLElement>('[data-note]');
    form?.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const topic = String(data.get('subject') || '').trim();
      const body = [
        `Name: ${data.get('name')}`,
        `Email: ${data.get('email')}`,
        ...(topic ? [`Subject: ${topic}`] : []),
        '',
        String(data.get('message')),
      ].join('\n');
      const url = `mailto:${TO}?subject=${encodeURIComponent('via website')}&body=${encodeURIComponent(body)}`;
      if (note) {
        note.hidden = false;
        note.innerHTML = 'Your email program should open with this message, ready to send. If it doesn’t, <a data-link>open it here</a> or write to ' + TO + '.';
        note.querySelector('a')?.setAttribute('href', url);
      }
      window.location.href = url;
    });
  </script>
</Base>
