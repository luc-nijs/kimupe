---
import Base from '../layouts/Base.astro';
import { SHEETS, lecturesHtml } from '../lib/sheets.js';
import { load } from '../lib/load.js';
import lecCsv from '../data/KIMUPE_lectures.csv?raw';

// The lectures come from the sheet KIMUPE_lectures (see src/lib/sheets.js).
const lectures = await load(SHEETS.lectures, lecCsv);
---
<Base title={"Lectures and Workshops | KiMuPe"} description={"Lectures, workshops and presentations by Luc Nijs on the kinemusical approach and embodiment in music education, from 2024 to 2026."} path="/dissemination">
  <div class="page">
    <h1 class="title" style="margin-bottom:8px">Publications</h1>
    <p>click <a class="orange plain" href="/publications">here</a></p>
    <h2 class="title" style="margin-top:36px">Lectures &amp; workshops</h2>
    <div class="talks" id="lectures" set:html={lecturesHtml(lectures)} />
  </div>
</Base>

<script>
  // Read the sheet again in the browser, so a new lecture shows up straight away.
  import { SHEETS, parseCSV, lecturesHtml } from '../lib/sheets.js';
  (async () => {
    if (!SHEETS.lectures) return;
    try {
      const r = await fetch(SHEETS.lectures, { cache: 'no-store' });
      if (r.ok) document.getElementById('lectures').innerHTML = lecturesHtml(parseCSV(await r.text()));
    } catch {}
  })();
</script>
