---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | KiMuPe" description="This page could not be found on the KiMuPe website." path="/404" noindex>
  <div class="page">
    <h1 class="title">Page not found</h1>
    <p>This page doesn't exist, or it has moved.</p>
    <p class="gap"><span class="orange" aria-hidden="true">➛</span> <a class="blue plain" href="/">Go to the home page</a></p>
  </div>
</Base>
